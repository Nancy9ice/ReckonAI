{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "ask": [
      "Edit(**)",
      "Write",
      "NotebookEdit"
    ],
    "allow": [
      "Read",
      "Bash(ls *)",
      "Bash(pwd *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(stat *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(tree *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(diff *)",
      "Bash(cmp *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(jq *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(whoami *)",
      "Bash(hostname *)",
      "Bash(uname *)",
      "Bash(date *)",
      "Bash(ps *)",
      "Bash(printenv *)",
      "Bash(echo *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git blame *)",
      "Bash(git remote -v)",
      "Bash(npm ls *)",
      "Bash(npm list *)",
      "Bash(npm view *)",
      "Bash(node --version)",
      "Bash(python3 --version)"
    ]
  },
  "disableAutoMode": "disable"
}
