# ReckonAI - PayPal sandbox credentials template
#
# Copy to .env and fill in. .env is gitignored and must never be committed:
# validation.md C9 fails the phase on any credential-shaped string in a
# tracked file, and specs/.../validation.md section 6 lists that as one of the
# five ways this phase fails outright.
#
#   cp .env.example .env
#
# Values below are placeholders, not real credentials.

# ---------------------------------------------------------------------------
# Sandbox app credentials - from developer.paypal.com, Apps & Credentials,
# Sandbox tab, your REST app. These do not expire.
# Used by scripts/probe_paypal.py (plan.md Group 1).
#
# From Phase 0b these are the PLATFORM app's credentials, not a merchant's.
# The product targets PayPal multiparty (specs/multiparty-direction.md), and a
# plain merchant app carries no partner scopes: probed 2026-11-07, such an app
# gets 403 on partner-referrals and referenced-payouts, and 422
# PLATFORM_FEES_NOT_SUPPORTED on an order carrying a platform fee.
#
# After changing these, mint a fresh token and check the scope list. A scope
# added after a token is issued does not appear in that token, so a stale token
# reports a false negative - see notes.md, "Transaction Search".
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=replace-with-sandbox-platform-client-id
PAYPAL_CLIENT_SECRET=replace-with-sandbox-platform-client-secret

# ---------------------------------------------------------------------------
# BN code, aka Build Notation or Partner Attribution ID. Sent as the
# PayPal-Partner-Attribution-Id header. Required by the partner-referrals and
# referenced-payouts APIs.
#
# Found in the developer dashboard: Apps & Credentials, your app, App Settings,
# under the Reports section. It is per app. Take the real value rather than
# inventing one.
# ---------------------------------------------------------------------------
PAYPAL_BN_CODE=replace-with-app-bn-code

# ---------------------------------------------------------------------------
# The ORIGINAL merchant app, kept alongside the platform app on purpose.
#
# Phase 0's fixtures belong to merchant C24NAWELTTHXJ. Under any other
# credentials they return 404 - fixtures.md records this happening once
# already, in "Void fixtures from the previous account". Losing them would
# permanently break validation.md C2, which re-probes those ids to prove the
# observed column is reproducible. Optional, but cheap to keep.
# ---------------------------------------------------------------------------
PAYPAL_MERCHANT_CLIENT_ID=replace-with-original-merchant-client-id
PAYPAL_MERCHANT_CLIENT_SECRET=replace-with-original-merchant-client-secret

# ---------------------------------------------------------------------------
# Multiparty participants. Blank until the seller is onboarded under the
# platform - these come out of onboarding, not from the dashboard.
#
#   PLATFORM_MERCHANT_ID  the platform account's own merchant id, from
#                         sandbox.paypal.com. Only needed when a platform fee
#                         should go somewhere other than the API caller;
#                         unset means the caller's account receives it.
#   SELLER_MERCHANT_ID    the onboarded seller, used as
#                         purchase_units[].payee.merchant_id and as the
#                         payer_id claim in PayPal-Auth-Assertion.
#   SELLER_EMAIL          the seller sandbox account's email - the alternative
#                         Auth-Assertion claim, and used in onboarding.
# ---------------------------------------------------------------------------
PAYPAL_PLATFORM_MERCHANT_ID=
PAYPAL_SELLER_MERCHANT_ID=
PAYPAL_SELLER_EMAIL=

# ---------------------------------------------------------------------------
# Additional multiparty sellers, for the capture that feeds the demo dataset.
# Added 2026-11-08 with the replan's R16, which moved the PayPal capture ahead
# of Block B.
#
# WHY MORE THAN ONE. PayPal puts exactly one payee on a purchase unit, so an
# order split across two sellers needs two accounts onboarded under the
# platform. That split is the product: a single customer payment creating
# obligations to several sellers is what specs/mission.md section 3 describes,
# and a one-seller dataset cannot demonstrate it.
#
# SLOT 1 IS THE PAIR ABOVE. PAYPAL_SELLER_MERCHANT_ID and PAYPAL_SELLER_EMAIL
# keep their names: scripts/probe_paypal.py reads them, and Phase 0's
# validation C2 re-probes its fixtures through them, so renaming would break a
# check that proves the observed column is reproducible. The capture module
# treats them as seller 1 and reads PAYPAL_SELLER_1_* only as an override.
#
# NO CLIENT SECRET PER SELLER, deliberately. The platform reads a seller's
# records with PayPal-Auth-Assertion, whose claim is the merchant id or the
# email - both below. Only the disputes API needs a seller's own credentials
# (specs/2026-11-07-multiparty-field-discovery/notes.md section 4.7), and
# disputes are out of scope for the capture. Less secret material in the file
# is worth having for its own sake.
#
# CURRENCY is declared rather than inferred. It decides which orders can be
# cross-currency, and guessing it would mean a conversion that silently never
# happens - the FX scenario would pass while testing nothing.
#
# CAPABILITIES ARE GRANTED PER SELLER AT ONBOARDING, through the platform's
# partner referral, and the simpler onboarding flow excludes Platform Fee and
# Delayed Disbursement outright (specs/multiparty-direction.md section 8.1).
# A referral that *requests* a capability is not proof it was granted, so the
# capture verifies each one before relying on it.
#
#   Slot  Currency  Capabilities needed                      Covers
#   1     USD       PAYMENT, REFUND, PARTNER_FEE             the existing
#                                                            seller
#   2     USD       PAYMENT, REFUND, PARTNER_FEE             with slot 1, the
#                                                            multi-seller order
#   3     EUR       the above plus DELAY_FUNDS_DISBURSEMENT   cross-currency
#                                                            settlement, and
#                                                            the held-funds and
#                                                            release records
#
# A fourth seller without PARTNER_FEE is deliberately NOT required. The dataset
# has one (vendor-dunlin) to prove the engine does not flag a missing platform
# fee for a seller never granted the capability - but there is nothing to
# capture for that case, because the whole point is that no platform fee record
# exists. Omitting the fee on that order produces the same provider evidence,
# and the capability flag is marketplace-side metadata either way.
# ---------------------------------------------------------------------------

# Slot 1: the existing seller above. Confirmed USD, 2026-11-08.
PAYPAL_SELLER_1_CURRENCY=USD

# Slot 2: second USD seller. This is the one that makes a real multi-seller
# order possible. Onboard with PAYMENT, REFUND, PARTNER_FEE.
PAYPAL_SELLER_2_MERCHANT_ID=
PAYPAL_SELLER_2_EMAIL=
PAYPAL_SELLER_2_CURRENCY=USD

# Slot 3: EUR seller. Carries specs/mission.md section 6 scenario 3 - a
# currency-conversion discrepancy - and the DELAYED held-funds states.
# Onboard with PAYMENT, REFUND, PARTNER_FEE, DELAY_FUNDS_DISBURSEMENT.
#
# This slot also corrects a real error. Block A's seeded conversion converts
# the gross less commission, where PayPal was observed to convert the **net**,
# after its own fee - specs/paypal-fields.md is explicit that converting the
# gross "is wrong by the whole fee". A real capture here replaces the invented
# figure with PayPal's own.
PAYPAL_SELLER_3_MERCHANT_ID=
PAYPAL_SELLER_3_EMAIL=
PAYPAL_SELLER_3_CURRENCY=EUR

# ---------------------------------------------------------------------------
# Sandbox REST base URL. Recorded as a Group 0 step 4 prerequisite.
# Live is api-m.paypal.com - this phase never touches it. Nothing in this
# project moves money (mission.md P6), but a live base URL would make real
# API calls against a real account, so keep this pointed at sandbox.
# ---------------------------------------------------------------------------
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ---------------------------------------------------------------------------
# Bearer token for the paypal-sandbox MCP server.
#
# IMPORTANT: the MCP server does NOT read this file. Its config is
#   "Authorization": "Bearer ${PAYPAL_SANDBOX_ACCESS_TOKEN}"
# expanded from Claude Code's own process environment at startup. To make the
# MCP server work, this variable must be exported in your shell before
# launching claude - for example sourced from a file outside this repo:
#
#   ~/.config/reckonai/paypal-sandbox.env   (chmod 600)
#
# Mint it by exchanging the client id and secret above:
#
#   curl -s -X POST "$PAYPAL_API_BASE/v1/oauth2/token" \
#     -u "$PAYPAL_CLIENT_ID:$PAYPAL_CLIENT_SECRET" \
#     -d grant_type=client_credentials
#
# These tokens EXPIRE, typically within hours. On expiry the MCP server fails
# with ECONNRESET, which looks like a network fault but is an auth failure -
# an empty or rejected bearer makes the SSE stream drop. Re-mint rather than
# debugging the connection. See notes.md, "Root cause of prerequisite 2".
#
# The probe script does not use this token. It authenticates with the client
# id and secret itself, so it keeps working after this token has expired.
# ---------------------------------------------------------------------------
PAYPAL_SANDBOX_ACCESS_TOKEN=replace-with-minted-access-token

# ---------------------------------------------------------------------------
# Investigation agent credentials (Block E, specs/tech-stack.md section 5).
#
# Only the key for the SELECTED provider is needed. AGENT_PROVIDER chooses
# which, and the agent asserts its key at the point of use rather than at
# startup - the web service and the worker read the same Settings object and
# neither makes a model call.
#
# Both are absent in CI on purpose. Every test runs against a stubbed runner
# and makes no API call, so a missing key here fails nothing; a test that
# silently reached a live API would be billing a credit card to assert a
# fixture.
# ---------------------------------------------------------------------------
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
OPENAI_API_KEY=replace-with-openai-api-key

# ---------------------------------------------------------------------------
# Live ingestion (specs/2026-11-11-live-ingestion).
#
#   PAYPAL_WEBHOOK_ID  the id PayPal shows after you register the webhook
#                      (developer dashboard, your sandbox app, Webhooks). Without
#                      it every delivery is refused.
#   SIM_WRITE_SECRET   make one up, for example `openssl rand -hex 32`, and never
#                      leave the placeholder in place: it is the only thing
#                      guarding the simulator's write endpoints, which are off
#                      unless SIM_WRITE_ENABLED=true.
# ---------------------------------------------------------------------------
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id
SIM_WRITE_SECRET=replace-with-a-long-random-string
